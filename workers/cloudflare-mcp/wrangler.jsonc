{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emeka45-cloudflare-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV"
    }
  ]
}
